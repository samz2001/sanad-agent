          ]
        },
        {
          "article_number": 12,
          "arabic_name": "المادة الثانية عشرة",
          "number_ar": "الثانية عشرة",
          "arabic_content": "إذا كانت حالة الموظف تدل على عجزه الصحي عن العمل فيعرض على الهيئة الطبية العامة لتقرر إما عجزه عن العمل بصورة جزئية أو عجزه\nبصورة دائمة وقطعية أو ما تراه في شأنه.",
